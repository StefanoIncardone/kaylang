#*
PROBLEM: Summation of Primes (https://projecteuler.net/problem=10)
The sum of the primes below 10 is 2 + 3 + 5 + 7 = 17.

QUESTION:
Find the sum of all the primes below two million.
*#

var sum: i64 = 0;
var number: i64 = 1;
loop number < 2000000 {
    var is_prime: bool = true;
    if number == 2 || number == 3 {
        ;
    }
    else if number <= 1 || number % 2 == 0 || number % 3 == 0 {
        is_prime = false;
    }
    else {
        var divisor: i64 = 5;
        loop divisor ** 2 <= number {
            if number % divisor == 0 || number % (divisor + 2) == 0 {
                is_prime = false;
                break;
            }

            divisor += 6;
        }
    }

    sum += is_prime * number;
    number += 1;
}

print "expected: "; println 142913828922;
print "actual:   "; println sum;
