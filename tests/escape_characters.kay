#* "literal.string.valid": {
   "name": "string.quoted.double.kay",
   "match": "\"((?:[^\\\\\"\\r\\n]|\\\\(?:\\d(?:\\w|[^\\x00-\\x7f])*(?:\\\\|(?!\\\\))|\\^[^\\r\\n]|[^^\\d\\r\\n]))*)\"",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#escape" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },

  "non_escape": {
   "match": "[^\\\\\"\\r\\n]"
  },

(?:[^\\r\\n]|(?!'))
  *#
