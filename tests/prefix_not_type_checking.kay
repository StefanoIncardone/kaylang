let s = "s";
let a = 'a';
let i = 1;
let b = true;

let as = ["s"];
let aa = ['a'];
let ai = [1];
let ab = [true];

## let test_not_literal_string = !"s";  #* Error *#
let test_not_literal_ascii  = !'a';  #* Correct *#
let test_not_literal_i64    = !12;   #* Correct *#
let test_not_literal_bool   = !true; #* Correct *#

