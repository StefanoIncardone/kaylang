## let test_not_variable_string  = !s; #* Error *#
let test_not_variable_ascii   = !a; #* Correct *#
let test_not_variable_i64     = !i; #* Correct *#
let test_not_variable_bool    = !b; #* Correct *#

## let test_not_variable_array_of_string = !as; #* Error *#
